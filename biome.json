{
	"$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
	"files": {
		"includes": [
			"**",
			"!**/references",
			"!**/dist",
			"!**/node_modules",
			"!**/.svelte-kit",
			"!**/build",
			"!**/web/marketing/.wrangler",
			"!**/dist/signetai/dashboard",
			"!**/web/marketing/.astro",
			"!**/memorybench/data",
			"!**/memorybench/dist",
			"!**/memorybench/node_modules",
			"!**/_app",
			"!**/target",
			"!**/coverage",
			"!**/*.generated.*",
			"!**/libs/sdk/src/generated"
		]
	},
	"formatter": {
		"indentStyle": "tab",
		"lineWidth": 120
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noAssignInExpressions": "off",
				"noExplicitAny": "error"
			},
			"style": {
				"noNonNullAssertion": "error"
			},
			"complexity": {
				"noForEach": "error",
				"noBannedTypes": "error"
			},
			"a11y": {
				"recommended": true
			},
			"security": {
				"recommended": true
			}
		}
	},
	"json": {
		"formatter": {
			"indentStyle": "tab"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"overrides": [
		{
			"includes": ["**/*.svelte"],
			"assist": {
				"actions": {
					"source": {
						"organizeImports": "off"
					}
				}
			},
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedImports": "off",
						"noUnusedVariables": "off"
					}
				}
			}
		},
		{
			"includes": ["**/memorybench/**"],
			"formatter": {
				"enabled": false
			},
			"assist": {
				"actions": {
					"source": {
						"organizeImports": "off"
					}
				}
			},
			"linter": {
				"enabled": true,
				"rules": {
					"preset": "none",
					"correctness": {
						"noUnusedImports": "error",
						"noUnusedVariables": "error"
					},
					"style": {
						"noNonNullAssertion": "off",
						"useNodejsImportProtocol": "off",
						"noInferrableTypes": "off",
						"useImportType": "off",
						"useNumberNamespace": "off",
						"useTemplate": "off",
						"noUselessElse": "off",
						"noUnusedTemplateLiteral": "off"
					},
					"complexity": {
						"noStaticOnlyClass": "off",
						"noThisInStatic": "off",
						"noForEach": "off"
					},
					"suspicious": {
						"noExplicitAny": "off"
					},
					"a11y": {
						"recommended": false
					},
					"security": {
						"recommended": false
					}
				}
			}
		}
	]
}
